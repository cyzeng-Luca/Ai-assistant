# ── Postgres ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=module_assistant
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/module_assistant

# ── Redis ──
REDIS_URL=redis://redis:6379

# ── DeepSeek API ──
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# ── Anthropic API ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=deepseek-v4-pro

# ── DashScope Embedding ──
DASHSCOPE_API_KEY=

# ── JWT ──
JWT_SECRET=
JWT_EXPIRES_IN=24h

# ── Server ──
SERVER_PORT=3001
NODE_ENV=production

# ── Client ──
CLIENT_PORT=80

# ── Alibaba Bailian ──
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
BAILIAN_WORKSPACE_ID=
BAILIAN_INDEX_ID=

# ── LangSmith ──
LANGSMITH_API_KEY=

# ── Viking ──
VIKING_BASE_URL=http://api-knowledgebase.mlp.cn-beijing.volces.com

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@components": ["./src/components"],
      "@components/*": ["./src/components/*"],
      "@hooks": ["./src/hooks"],
      "@hooks/*": ["./src/hooks/*"],
      "@pages": ["./src/pages"],
      "@pages/*": ["./src/pages/*"],
      "@router": ["./src/router"],
      "@router/*": ["./src/router/*"],
      "@services": ["./src/services"],
      "@services/*": ["./src/services/*"],
      "@store": ["./src/store"],
      "@store/*": ["./src/store/*"],
      "@lib": ["./src/lib"],
      "@lib/*": ["./src/lib/*"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test-setup.ts"]
}

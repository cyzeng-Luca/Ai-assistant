{
  "name": "module-assistant-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:debug": "NODE_OPTIONS='--inspect=9230' node --import tsx/esm --watch src/index.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "langgraph:dev": "npx @langchain/langgraph-cli dev",
    "docker:up": "docker compose -f ../docker-compose.local.yml up -d",
    "docker:down": "docker compose -f ../docker-compose.local.yml down"
  },
  "dependencies": {
    "@alicloud/bailian20231229": "^2.9.1",
    "@alicloud/credentials": "^2.4.4",
    "@alicloud/facebody20191230": "^6.0.0",
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/openapi-core": "^1.0.7",
    "@alicloud/tea-util": "^1.4.11",
    "@langchain/anthropic": "^1.3.29",
    "@langchain/core": "^1.0.0",
    "@langchain/deepseek": "^1.0.25",
    "@langchain/langgraph": "^1.2.9",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.1",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "axios": "^1.16.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.1",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^1.3.5",
    "openai": "^6.36.0",
    "pino": "^10.3.1",
    "rate-limit-redis": "^5.0.0",
    "tsx": "^4.19.0",
    "uuid": "^10.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@langchain/langgraph-cli": "^1.2.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.0",
    "prisma": "^7.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
